// CI overrides SPARKLE_PUBLIC_KEY with the repository variable at archive time.
SPARKLE_PUBLIC_KEY =
// `$()` keeps `//` from starting an xcconfig comment.
PRESETS_URL = https:/$()/finetext.app/api/presets
// Flowcy agent API. Every configuration uses production.
FLOWCY_BASE_URL = https:/$()/www.flowcy.dev
// First-party rxlab-auth OAuth client for FineText (redirect finetext://oauth-callback).
FLOWCY_OAUTH_CLIENT_ID = client_de18d5f7d1a8485e9f874728912385a3
// Release is signed without a provisioning profile, so it cannot carry associated domains (no passkeys).
FLOWCY_PASSKEYS_ENABLED = NO
FINETEXT_ENTITLEMENTS = Configuration/FineText.entitlements
